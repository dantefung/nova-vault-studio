---
/**
 * 禅模式开关（沉浸式阅读）
 *
 * 切换 html[data-zen]：隐藏顶栏/侧栏/大纲/页脚/评论，正文居中放大。
 * 状态存 localStorage，首屏由 THEME_INIT_SCRIPT 同步应用（无闪烁）。
 * 键盘快捷键 Z 切换（输入焦点时不触发）。
 */
import { ZEN_STORAGE_KEY } from '../lib/theme'
---

<button
  type="button"
  class="inline-flex size-8 items-center justify-center rounded-[9px] border border-line/70 bg-surface-elv/78 text-muted backdrop-blur-[14px] backdrop-saturate-150 shadow-[var(--ui-shadow)] transition-colors duration-150 hover:bg-ink/8 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:bg-accent aria-pressed:text-white"
  id="vp-zen-toggle"
  aria-label="切换禅模式"
  aria-pressed="false"
  title="禅模式（专注阅读，快捷键 Z）"
>
  <svg
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21" />
    <circle cx="12" cy="12" r="4.25" />
  </svg>
</button>

<script define:vars={{ ZEN_STORAGE_KEY }}>
  const btn = document.getElementById('vp-zen-toggle')
  const root = document.documentElement

  function applyZen(on) {
    if (on) root.dataset.zen = 'true'
    else delete root.dataset.zen
    btn?.setAttribute('aria-pressed', String(on))
  }

  applyZen(root.dataset.zen === 'true')

  btn?.addEventListener('click', () => {
    const on = root.dataset.zen !== 'true'
    applyZen(on)
    try {
      if (on) localStorage.setItem(ZEN_STORAGE_KEY, '1')
      else localStorage.removeItem(ZEN_STORAGE_KEY)
    } catch (e) {}
  })

  document.addEventListener('keydown', (e) => {
    const tag = (e.target.tagName || '').toLowerCase()
    if (tag === 'input' || tag === 'textarea' || e.target.isContentEditable) return
    if (e.key === 'z' || e.key === 'Z') {
      const on = root.dataset.zen !== 'true'
      applyZen(on)
      try {
        if (on) localStorage.setItem(ZEN_STORAGE_KEY, '1')
        else localStorage.removeItem(ZEN_STORAGE_KEY)
      } catch (err) {}
    }
  })
</script>
