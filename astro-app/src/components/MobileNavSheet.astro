---
/**
 * 移动端导航抽屉
 *
 * VitePress 时期的 MobileNavSheet.vue 用 Vue 组件 + body class 实现；
 * 这里改为原生 <dialog>，无框架依赖，行为一致。
 *
 * 导航项直接从 generated/nav.json 服务端渲染 —— 之前 <nav> 是空的、
 * 没有任何 JS 往里填内容，导致点开汉堡后是一个空抽屉，移动端完全无法导航。
 */
import navData from '../generated/nav.json'
---

<button
  type="button"
  class="inline-flex size-8 items-center justify-center rounded-[9px] border border-line/70 bg-surface-elv/78 text-ink backdrop-blur-[14px] backdrop-saturate-150 shadow-[var(--ui-shadow)] transition-colors duration-150 hover:bg-ink/8 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  id="vp-mobile-nav-toggle"
  aria-label="打开导航"
  title="导航"
>
  <svg
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M3 6h18M3 12h18M3 18h18" />
  </svg>
</button>

<dialog class="vp-mobile-nav" id="vp-mobile-nav" aria-label="移动端导航">
  <div class="vp-mobile-nav-head">
    <span class="vp-mobile-nav-brand">System Vault</span>
    <button
      type="button"
      class="inline-flex size-8 items-center justify-center rounded-[9px] text-muted transition-colors duration-150 hover:bg-ink/8 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      id="vp-mobile-nav-close"
      aria-label="关闭导航"
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <nav class="vp-mobile-nav-body" id="vp-mobile-nav-body" aria-label="站点导航">
    <ul class="vp-mobile-nav-list">
      {
        navData.nav.map((group: any) => (
          <li>
            {group.items?.length ? (
              <details class="vp-mobile-nav-group">
                <summary>{group.text}</summary>
                <ul>
                  <li>
                    <a href={group.link} class="vp-mobile-nav-overview">{group.text}总览</a>
                  </li>
                  {group.items.map((item: any) => (
                    <li>
                      <a href={item.link}>{item.text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={group.link}>{group.text}</a>
            )}
          </li>
        ))
      }
      <li>
        <a href="https://github.com/dantefung/nova-vault-studio" target="_blank" rel="noreferrer">GitHub ↗</a>
      </li>
    </ul>
  </nav>
</dialog>

<script>
  const toggle = document.getElementById('vp-mobile-nav-toggle')
  const dialog = document.getElementById('vp-mobile-nav') as HTMLDialogElement | null
  const close = document.getElementById('vp-mobile-nav-close')

  toggle?.addEventListener('click', () => {
    dialog?.showModal()
  })
  close?.addEventListener('click', () => {
    dialog?.close()
  })
  // 点击遮罩关闭
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })
  // 点导航链接后关闭，避免返回时抽屉仍开着
  dialog?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => dialog.close())
  })
</script>
