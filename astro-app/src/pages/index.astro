---
/**
 * 落地页（首页）
 *
 * 对应 VitePress 时期的 HomeLayout.vue。
 * 结构与内容保持一致：知识分类入口 + 最近更新。
 */
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import SearchBox from '../components/SearchBox.astro'
import { entryToUrl } from '../lib/content'

const libraryEntries = [
  { label: '指南', description: '从基础配置到日常工作流，先从这里开始。', href: '/md/guide/getting-started', featured: true },
  { label: 'Wiki', description: '把概念、模式与实践连接成可复用的知识。', href: '/md/wiki/' },
  { label: '专栏', description: '围绕 AI、开发与独立创造的长期思考。', href: '/md/columns/' },
  { label: '书籍', description: '适合慢读、反复查阅与持续积累的书架。', href: '/md/books/' },
  { label: '教程', description: '按步骤完成具体事情的实践材料。', href: '/md/tutorial/' },
  { label: 'AGI', description: '关于智能系统、模型与未来工作的记录。', href: '/md/agi/' },
  { label: '商业', description: '市场、模式、投资与产品判断。', href: '/md/business/' },
  { label: 'Slides', description: '可横向阅读的演示与视觉化内容。', href: '/md/slides/' },
]

// 最近更新：按 frontmatter date 倒序，取最新的 6 篇
const entries = await getCollection('docs')

/** 统一取时间戳：date 可能是 Date、字符串，或解析失败的原值 */
function timeOf(entry: any): number {
  const d = entry?.data?.date
  if (d instanceof Date) return d.getTime()
  if (typeof d === 'number') return d
  if (typeof d === 'string') {
    const t = Date.parse(d)
    if (!Number.isNaN(t)) return t
  }
  return 0
}

const recent = entries
  .filter((e) => timeOf(e) > 0)
  .sort((a, b) => timeOf(b) - timeOf(a))
  .slice(0, 6)
  .map((e) => ({
    title: (e.data as any).title ?? e.id.split('/').pop() ?? e.id,
    href: entryToUrl(e),
    meta: formatMeta(e),
  }))

function formatMeta(entry: any): string {
  const ts = timeOf(entry)
  const dateStr = ts ? new Date(ts).toISOString().slice(0, 10) : ''
  const path = entry.id.split('/')
  const section = path[0] ?? ''
  const labels: Record<string, string> = {
    guide: '指南',
    wiki: '知识库',
    columns: '专栏',
    books: '书籍',
    business: '商业',
    tutorial: '教程',
    agi: 'AGI',
    slides: '幻灯片',
    sitelog: '站点日志',
  }
  const label = labels[section] ?? section
  return dateStr ? `${label} · ${dateStr}` : label
}
---

<BaseLayout
  title="System Vault"
  description="系统知识库 - 凡是过往，皆为序章"
  landingTheme="quiet"
  bodyClass="vp-landing"
>
  <main class="tw-landing">
    <!-- Hero：柔和渐变背景 + 大标题 + 搜索/CTA -->
    <section class="tw-hero" aria-labelledby="vp-library-title">
      <div class="tw-hero-glow" aria-hidden="true"></div>
      <div class="tw-hero-inner">
        <span class="tw-kicker">
          <span class="tw-kicker-dot" aria-hidden="true"></span>
          A PERSONAL KNOWLEDGE LIBRARY
        </span>
        <h1 id="vp-library-title" class="tw-hero-title">
          A personal <span class="tw-hero-accent">knowledge</span> library
        </h1>
        <p class="tw-hero-lead">把零散知识，整理成可以反复使用的系统。</p>
        <p class="tw-hero-sub">
          AI、开发、商业、书籍与长期学习的工作记录。安静地阅读，清楚地找到下一步。
        </p>
        <div class="tw-hero-actions">
          <SearchBox variant="hero" />
          <a href="/md/guide/getting-started" class="btn btn-primary tw-cta">
            开始阅读 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 分类入口：悬浮卡片 + 编号 -->
    <section class="tw-section" aria-labelledby="vp-library-start-title">
      <div class="tw-section-head">
        <span class="tw-kicker">EXPLORE THE LIBRARY</span>
        <h2 id="vp-library-start-title">知识分类入口</h2>
        <p class="tw-section-sub">从八个方向进入这座持续生长的知识库</p>
      </div>
      <div class="tw-grid">
        {
          libraryEntries.map((entry, i) => (
            <a href={entry.href} class:list={['tw-card', { 'tw-card-featured': entry.featured }]}>
              <span class="tw-card-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="tw-card-label">{entry.label}</span>
              <span class="tw-card-desc">{entry.description}</span>
              <span class="tw-card-arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 最近更新：紧凑列表 + 徽章 -->
    <section class="tw-section" aria-labelledby="vp-library-recent-title">
      <div class="tw-section-head">
        <span class="tw-kicker">RECENTLY ADDED</span>
        <h2 id="vp-library-recent-title">最近更新</h2>
        <p class="tw-section-sub">最新收录的文章与笔记</p>
      </div>
      <div class="tw-recent">
        {
          recent.map((item, i) => (
            <a href={item.href} class="tw-recent-item">
              <span class="tw-recent-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="tw-recent-body">
                <span class="tw-recent-title">{item.title}</span>
                <span class="badge badge-ghost badge-sm tw-recent-badge">{item.meta}</span>
              </span>
              <span class="tw-recent-arrow" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
