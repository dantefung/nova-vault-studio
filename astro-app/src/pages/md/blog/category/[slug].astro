---
/**
 * 博客分类页
 *
 * 对应 VitePress 时期的 CategoryArchiveLayout.vue。
 * /md/blog/category/<slug>/ 由动态路由生成。
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import blogIndex from '@generated/blog-index.json'

export async function getStaticPaths() {
  const index = blogIndex as any
  return index.categories.map((c: any) => ({
    params: { slug: c.slug },
    props: { category: c },
  }))
}

const { category } = Astro.props
const index = blogIndex as any
const articles = index.articles.filter((a: any) => a.category === category.slug)
---

<BaseLayout
  title={`${category.title} · 博客分类`}
  description={`分类「${category.title}」下的 ${articles.length} 篇文章。`}
  landingTheme="quiet"
  bodyClass="vp-blog-page"
>
  <main class="vp-blog-main">
    <section class="vp-blog-hero">
      <h1>{category.title}</h1>
      <p class="vp-blog-lead">共 {articles.length} 篇。</p>
    </section>

    <nav class="vp-blog-views" aria-label="博客视图">
      <a href="/md/blog/">最新</a>
      <a href="/md/blog/category/" class="is-active">分类</a>
      <a href="/md/blog/archive/">归档</a>
      <a href="/md/blog/series/">系列</a>
    </nav>

    <ul class="vp-blog-list">
      {
        articles.map((a: any) => (
          <li>
            <a href={a.path}>{a.title}</a>
            <span class="vp-blog-list-meta">
              {a.date}
              {a.author ? ` · ${a.author}` : ''}
            </span>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
