{
  "name": "system-vault-astro",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "npm run build:data",
    "build:data": "cd .. && node scripts/normalize-dates.mjs && node scripts/build-blog-index.js && node scripts/build-astro-nav.mjs && node scripts/build-astro-doc-index.mjs && node scripts/build-astro-search-index.mjs && node scripts/copy-assets.mjs && node scripts/build-resource-nav.js --all",
    "clean:cache": "rm -rf node_modules/.astro .astro",
    "build": "astro build",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "check:links": "cd .. && node scripts/check-links.mjs",
    "check:frontmatter": "cd .. && python3 .claude/hooks/check-frontmatter.py docs/md 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/lxgw-wenkai": "5.2.5",
    "astro": "^5.6.0",
    "gray-matter": "^4.0.3",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
