/* ENDING */
.ending{padding:80px 0;border-top:2px solid var(--rule);margin-top:80px}
.ending h1{font-size:28px;font-weight:700;color:var(--ink);margin-bottom:32px}

/* FOOTER BADGE */
.gh-footer{text-align:center;padding:60px 0 80px;font-family:'Noto Sans SC',sans-serif;font-size:12px;color:var(--dim);letter-spacing:.08em}
.gh-footer a{border:none;color:var(--orange)}
.gh-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--orange);margin:0 8px;vertical-align:middle}

/* SOCIAL CARDS */
.social-grid{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0 8px}
.social-card{display:inline-flex;align-items:center;gap:10px;padding:10px 18px;background:var(--card);border:1px solid var(--rule);border-radius:8px;text-decoration:none;transition:border-color .2s,transform .15s;font-family:'Noto Sans SC',sans-serif}
.social-card:hover{border-color:var(--orange);transform:translateY(-1px)}
.social-card .sc-platform{font-size:11px;color:var(--dim);letter-spacing:.06em}
.social-card .sc-name{font-size:14px;color:var(--ink);font-weight:500}
.social-card-plain{padding:10px 18px;font-family:'Noto Sans SC',sans-serif}
.social-card-plain .sc-platform{font-size:11px;color:var(--dim);letter-spacing:.06em}
.social-card-plain .sc-name{font-size:14px;color:var(--ink);font-weight:500}

/* FRONT GUIDE BAR */
.front-guide{margin-top:40px;padding:20px 24px;background:var(--card);border-radius:8px;border:1px solid var(--rule);font-family:'Noto Sans SC',sans-serif;font-size:14px;color:var(--dim);line-height:1.7;letter-spacing:.03em}
.front-guide span{color:var(--orange);font-weight:500}

/* PRODUCT SHOWCASE */
.product-section{padding:80px 0 60px;margin-top:96px;border-top:3px solid var(--orange);page-break-before:always}
.product-section .section-label{font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.3em;color:var(--orange);text-transform:uppercase;margin-bottom:24px}
.product-section h1{font-size:34px;font-weight:700;color:var(--ink);margin-bottom:16px;line-height:1.3}
.product-section .section-lead{font-size:16px;color:var(--dim);line-height:1.8;margin-bottom:48px;max-width:560px}

/* CONSULTING CARDS */
.consult-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:48px}
.consult-card{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:32px 28px;position:relative;transition:border-color .2s}
.consult-card:hover{border-color:var(--orange)}
.consult-card .card-tag{display:inline-block;padding:4px 12px;border-radius:14px;font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.1em;margin-bottom:20px}
.consult-card:first-child .card-tag{background:rgba(243,89,53,.1);color:var(--orange)}
.consult-card:last-child .card-tag{background:rgba(178,207,0,.15);color:#7a8c00}
.consult-card h3{font-size:18px;font-weight:700;color:var(--ink);margin-bottom:8px}
.consult-card .card-price{font-size:28px;font-weight:700;color:var(--orange);margin-bottom:6px;font-family:'Noto Sans SC',sans-serif}
.consult-card .card-price-note{font-size:13px;color:var(--dim);margin-bottom:20px}
.consult-card .card-for{font-size:14px;color:var(--dim);margin-bottom:16px;line-height:1.7;font-family:'Noto Sans SC',sans-serif}
.consult-card .card-for strong{color:var(--ink);font-weight:500}
.consult-card .card-deliver{margin:0;padding:0;list-style:none}
.consult-card .card-deliver li{font-size:14px;color:var(--ink);padding:8px 0;border-bottom:1px solid var(--rule-light);line-height:1.6}
.consult-card .card-deliver li:last-child{border-bottom:none}
.consult-card .card-deliver li::before{content:'✓ ';color:var(--orange);font-weight:700}
.consult-card .card-note{font-size:13px;color:var(--dim);margin-top:16px;font-style:italic;line-height:1.6}

/* PRODUCT CARD (MANUAL) */
.product-card{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:36px 32px;margin-bottom:48px;position:relative;transition:border-color .2s}
.product-card:hover{border-color:var(--green)}
.product-card .product-badge{display:inline-flex;align-items:center;gap:8px;padding:5px 14px;border-radius:14px;background:rgba(178,207,0,.15);color:#6b7a00;font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.08em;margin-bottom:20px;font-weight:500}
.product-card .product-badge .badge-dot{width:6px;height:6px;border-radius:50%;background:var(--green)}
.product-card h3{font-size:22px;font-weight:700;color:var(--ink);margin-bottom:10px}
.product-card .product-sub{font-size:15px;color:var(--dim);margin-bottom:24px;line-height:1.7}
.product-card .product-links{display:flex;gap:16px;flex-wrap:wrap}
.product-card .product-link{display:inline-flex;align-items:center;gap:6px;padding:10px 22px;border-radius:8px;font-family:'Noto Sans SC',sans-serif;font-size:14px;font-weight:500;letter-spacing:.03em;border:none;transition:all .2s}
.product-card .product-link.primary{background:var(--orange);color:#fff}
.product-card .product-link.primary:hover{background:#d94e2d}
.product-card .product-link.secondary{background:var(--bg);border:1px solid var(--rule);color:var(--ink)}
.product-card .product-link.secondary:hover{border-color:var(--ink)}

/* CONTACT BAR */
.contact-bar{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
.contact-bar .contact-text{font-size:15px;color:var(--ink);line-height:1.7}
.contact-bar .contact-text em{color:var(--dim);font-style:italic;font-size:14px}
.contact-bar .contact-wechat{font-family:'Noto Sans SC',sans-serif;font-size:16px;font-weight:600;color:var(--orange);letter-spacing:.05em}

@media (max-width:600px){
  .consult-grid{grid-template-columns:1fr}
  .contact-bar{flex-direction:column;text-align:center}
}

@media print{
  body{background:white}
  .pd,.cb,.cb-app{page-break-before:always}
