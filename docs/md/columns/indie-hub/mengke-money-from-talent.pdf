}
/* READING NAV */
.read-nav{position:sticky;top:0;z-index:999;background:rgba(245,239,228,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--rule);padding:12px 52px;display:flex;align-items:center;justify-content:space-between;font-family:'Noto Sans SC',sans-serif;font-size:13px}
.read-nav a{color:var(--dim);border:none;text-decoration:none;transition:color .2s}
.read-nav a:hover{color:var(--orange)}
.read-nav .nav-title{color:var(--ink);font-weight:500;letter-spacing:.03em}
.read-nav .nav-btn{padding:6px 16px;border-radius:6px;border:1px solid var(--rule);font-size:12px;letter-spacing:.05em}
.read-nav .nav-btn:hover{border-color:var(--orange);color:var(--orange)}
@media print{.read-nav{display:none}}
</style>
