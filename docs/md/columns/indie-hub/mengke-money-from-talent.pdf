<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;500;700&family=Noto+Sans+SC:wght@300;400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f5efe4;
  --card:#f2ede4;
  --sidebar:#eee8de;
  --ink:#333333;
  --dim:#7a7a7a;
  --orange:#f35935;
  --green:#b2cf00;
  --rule:#ddd5c4;
  --rule-light:#e8e0d2;
}
body{background:var(--bg);color:var(--ink);font-family:'Noto Serif SC',serif;font-size:17px;line-height:1.95;-webkit-font-smoothing:antialiased}
.bw{max-width:740px;margin:0 auto;padding:0 52px}
a{color:var(--orange);text-decoration:none;border-bottom:1px solid rgba(243,89,53,.3)}
a:hover{border-bottom-color:var(--orange)}

/* COVER */
.cover{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:80px 0 72px;position:relative}
.cover::after{content:'';position:absolute;bottom:0;left:52px;right:52px;height:2px;background:linear-gradient(90deg,var(--orange),var(--green))}
.clabel{font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.3em;color:var(--dim);text-transform:uppercase;margin-bottom:56px}
.ctitle{font-size:58px;font-weight:700;line-height:1.1;letter-spacing:.01em;margin-bottom:20px;color:var(--ink)}
.ctitle span{color:var(--orange)}
.csub{font-size:20px;font-weight:300;color:var(--dim);margin-bottom:64px;letter-spacing:.05em}
.cdot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--green);margin-right:10px;vertical-align:middle}
.cauthor{font-family:'Noto Sans SC',sans-serif;font-size:15px;color:var(--ink);letter-spacing:.08em}
.cbadge{display:inline-block;margin-top:40px;padding:7px 16px;border-radius:20px;background:var(--card);border:1px solid var(--rule);font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.15em;color:var(--dim)}

/* FRONT MATTER */
.frontmatter{padding:72px 0 60px;border-bottom:2px solid var(--rule)}
.frontmatter h1{display:none}
.frontmatter h2{font-size:13px;font-family:'Noto Sans SC',sans-serif;font-weight:500;letter-spacing:.15em;color:var(--orange);margin:2.8em 0 1em;padding-bottom:.5em;border-bottom:1px solid var(--rule-light);text-transform:uppercase}
.frontmatter h3{font-size:17px;font-weight:600;margin:2em 0 .7em;color:var(--ink);padding-left:14px;border-left:3px solid var(--orange)}
.frontmatter h4{font-size:14px;font-weight:500;color:var(--dim);margin:1.6em 0 .5em}
.frontmatter p{margin-bottom:1.3em;text-align:justify}
.frontmatter blockquote{background:var(--card);border-left:3px solid var(--orange);padding:14px 20px;margin:1.4em 0;border-radius:0 6px 6px 0}
.frontmatter blockquote p{margin-bottom:.5em;font-size:16px;color:var(--dim)}.frontmatter blockquote p:last-child{margin-bottom:0}
.frontmatter strong{font-weight:700;color:var(--ink)}.frontmatter em{color:var(--dim);font-style:italic}
.frontmatter ul{padding-left:22px;margin:.8em 0 1.2em}.frontmatter ul li{margin-bottom:.5em}
.frontmatter hr.sr{border:none;border-top:1px solid var(--rule-light);margin:2.4em 0}
.frontmatter table{width:100%;border-collapse:collapse;margin:1.2em 0;font-size:14px}
.frontmatter th{text-align:left;font-family:'Noto Sans SC',sans-serif;font-weight:500;font-size:11px;letter-spacing:.08em;color:var(--dim);border-bottom:2px solid var(--rule);padding:8px 12px;text-transform:uppercase}
.frontmatter td{padding:10px 12px;border-bottom:1px solid var(--rule-light);vertical-align:top;line-height:1.6}
.frontmatter td a{font-size:13px;word-break:break-all}
.frontmatter tr:last-child td{border-bottom:none}

/* PART DIVIDER */
.pd{padding:80px 0 64px;border-top:3px solid var(--orange);margin-top:96px}
.plab{font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.3em;color:var(--orange);margin-bottom:24px;text-transform:uppercase}
.pd h1{font-size:38px;font-weight:700;color:var(--ink);margin-bottom:24px;line-height:1.25}
.part-body p{font-size:16px;color:var(--dim);margin-bottom:1em;line-height:1.8}
.part-body blockquote{background:var(--card);border-left:3px solid var(--green);padding:14px 20px;margin:1.4em 0;border-radius:0 6px 6px 0;font-size:15px;color:var(--dim)}
.part-body blockquote p{margin-bottom:.4em}.part-body blockquote p:last-child{margin-bottom:0}
.part-body ul{padding-left:22px;margin:.6em 0 1em}.part-body ul li{font-size:15px;color:var(--dim);margin-bottom:.4em}

/* CHAPTER BREAK */
.cb{min-height:56vh;display:flex;flex-direction:column;justify-content:flex-end;padding:80px 0 60px;margin-top:96px;border-top:1px solid var(--rule)}
.cb-app{min-height:40vh;display:flex;flex-direction:column;justify-content:flex-end;padding:60px 0 48px;margin-top:80px;border-top:1px solid var(--rule)}
.cn{font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.3em;color:var(--orange);margin-bottom:20px;text-transform:uppercase}
.cb h1,.cb-app h1{font-size:34px;font-weight:700;line-height:1.3;color:var(--ink);margin-bottom:20px}
.cl{font-size:16px;color:var(--dim);max-width:500px;line-height:1.8;font-style:italic}

/* PROSE */
.prose{padding:56px 0 80px}
.prose p{margin-bottom:1.45em;text-align:justify}
.prose h2{font-size:20px;font-weight:700;margin:2.6em 0 .9em;color:var(--ink);padding-left:14px;border-left:3px solid var(--orange)}
.prose h3{font-size:17px;font-weight:600;margin:2em 0 .7em;color:var(--ink)}
.prose h4{font-size:15px;font-weight:500;color:var(--dim);margin:1.6em 0 .5em}
.prose blockquote{background:var(--card);border-left:3px solid var(--orange);padding:16px 22px;margin:1.8em 0;border-radius:0 6px 6px 0}
.prose blockquote p{margin-bottom:.6em;font-size:16px;color:var(--dim)}.prose blockquote p:last-child{margin-bottom:0}
.prose strong{font-weight:700;color:var(--ink)}.prose em{color:var(--dim)}
.prose ul{padding-left:22px;margin:1em 0 1.5em}.prose ul li{margin-bottom:.6em}
.prose hr.sr{border:none;border-top:1px solid var(--rule-light);margin:2.6em 0}
.prose table{width:100%;border-collapse:collapse;margin:1.4em 0;font-size:14px}
.prose th{text-align:left;font-family:'Noto Sans SC',sans-serif;font-size:11px;letter-spacing:.08em;color:var(--dim);border-bottom:2px solid var(--rule);padding:8px 12px}
.prose td{padding:10px 12px;border-bottom:1px solid var(--rule-light);vertical-align:top;line-height:1.6}
