# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit binary files (never diff as text, never normalize line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# SVG is XML text
*.svg text eol=lf

# Code and documentation
*.md text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
